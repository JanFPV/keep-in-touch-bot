# .env.example

BOT_TOKEN=your_token
DATABASE_PATH=/app/data/kitbot.db

DEFAULT_AVG_DAYS=30
INTERVAL_JITTER_PERCENT=0.2
# APScheduler stores jobs in memory only; this controls periodic reconciliation.
CHECK_INTERVAL_SECONDS=3600

# Optional: persist APScheduler jobs across restarts
SCHEDULER_DB_PATH=/app/data/scheduler.sqlite
